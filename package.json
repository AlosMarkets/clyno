    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chokidar": "^3.5.0",
    "commander": "^11.0.0",
    "gray-matter": "^4.0.0",
    "markdown-it": "^13.0.0",
